GEMINI_API_KEY=
# Override this model if the default is unavailable.
GEMINI_MODEL=gemini-flash-latest
PORT=5000
# Comma-separated exact frontend origins; trim spaces and omit trailing slashes.
# Deployed frontend origin format: https://<your-app>.vercel.app (no trailing slash).
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
# Defaults to 1 in production and 0 otherwise; set to 0 to disable proxy trust.
TRUST_PROXY=0
